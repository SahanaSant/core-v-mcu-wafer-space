 * SPDX-License-Identifier: Apache-2.0 WITH SHL-2.1
 *
 * Zero-delay timing models for the modules that flow/synth/stubs.sv black-boxes,
 * so OpenSTA can link the synthesised netlist and propagate a clock through it.
 *
 * These are structural, not characterised. Every arc is zero delay and every
 * pin is zero capacitance. Their whole job is to let the clock reach the flops
 * and to let paths terminate somewhere, so that `sta.sh` can report the
 * standard-cell critical path.
 *
 * Empty of cells as of ticket 24: every module stubs.sv used to black-box now
 * has a real implementation, so there is nothing left to link a zero-delay
 * model against. `apb_pll` (ideal clock source) and `a2_bootrom` (ideal boot
 * ROM) were the last two entries here; `rtl/gf180mcu/gf180_clk_gen.sv` and
 * `gf180_bootrom.sv` (ticket 23) replace them with real gates, so their paths
 * now carry real delay instead of a zero-delay placeholder. The library
 * preamble and templates below stay, ready for whatever the next black box
 * turns out to be; `sta.sh` still reads this file every run, and an
 * empty-of-cells liberty is a harmless, valid read.
 */

library (core_v_mcu_blackbox) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  capacitive_load_unit (1, pf);
  pulling_resistance_unit : "1ohm";
  leakage_power_unit : "1uW";
  default_max_transition : 3.0;

  /* One scalar template covers every arc, since every arc is zero. */
  lu_table_template (scalar) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.0");
  }

  /* Setup and hold want transition axes, not load. */
  lu_table_template (constraint) {
    variable_1 : related_pin_transition;
    variable_2 : constrained_pin_transition;
    index_1 ("0.0");
    index_2 ("0.0");
  }

  /* No cell definitions left; see the file header. */
}
